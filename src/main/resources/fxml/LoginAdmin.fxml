<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.grincare.controller.LoginAdminController"
            style="-fx-background-color: #f1f5f9;"
            prefWidth="1280" prefHeight="800">

    <!--
        VBox luar mengisi penuh layar (4 anchor = 0).
        Dua Region VBox.vgrow="ALWAYS" mengapit card → card terpusat vertikal.
        HBox alignment="CENTER" memusatkan card secara horizontal.
    -->
    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Region VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER">
            <!-- ===== CARD LOGIN ===== -->
            <VBox spacing="0" maxWidth="420"
                  style="-fx-background-color: white;
                         -fx-background-radius: 16;
                         -fx-padding: 40 48 40 48;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 20, 0, 0, 4);">

                <!-- Ikon gembok dalam lingkaran -->
                <HBox alignment="CENTER">
                    <HBox alignment="CENTER"
                          style="-fx-background-color: #f1f5f9;
                                 -fx-background-radius: 28;
                                 -fx-min-width: 56; -fx-min-height: 56;
                                 -fx-pref-width: 56; -fx-pref-height: 56;">
                        <Label text="🔐" style="-fx-font-size: 26px;"/>
                    </HBox>
                </HBox>

                <Region prefHeight="16"/>

                <!-- Judul -->
                <Label text="Login Admin" maxWidth="10000"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;
                              -fx-text-fill: #1e293b; -fx-alignment: CENTER;"/>
                <Label text="Akses panel manajemen klinik" maxWidth="10000"
                       style="-fx-font-size: 13px; -fx-text-fill: #64748b;
                              -fx-alignment: CENTER;"/>

                <Region prefHeight="8"/>

                <!-- Separator -->
                <Region maxWidth="10000" prefHeight="1" maxHeight="1"
                        style="-fx-background-color: #e2e8f0;"/>

                <Region prefHeight="24"/>

                <!-- Field Username -->
                <Label text="Username"
                       style="-fx-font-size: 12px; -fx-font-weight: bold;
                              -fx-text-fill: #374151;"/>
                <Region prefHeight="6"/>
                <HBox alignment="CENTER_LEFT" prefHeight="44"
                      style="-fx-background-color: #f8fafc;
                             -fx-background-radius: 8;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="👤"
                           style="-fx-font-size: 15px; -fx-padding: 0 8 0 14;
                                  -fx-text-fill: #94a3b8;"/>
                    <TextField fx:id="txtUsername" HBox.hgrow="ALWAYS"
                               promptText="Masukkan username..."
                               style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-padding: 0 14 0 4; -fx-font-size: 13px;"/>
                </HBox>

                <Region prefHeight="16"/>

                <!-- Field Password -->
                <Label text="Password"
                       style="-fx-font-size: 12px; -fx-font-weight: bold;
                              -fx-text-fill: #374151;"/>
                <Region prefHeight="6"/>
                <HBox alignment="CENTER_LEFT" prefHeight="44"
                      style="-fx-background-color: #f8fafc;
                             -fx-background-radius: 8;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="🔒"
                           style="-fx-font-size: 15px; -fx-padding: 0 8 0 14;
                                  -fx-text-fill: #94a3b8;"/>
                    <PasswordField fx:id="txtPassword" HBox.hgrow="ALWAYS"
                                   promptText="Masukkan password..."
                                   style="-fx-background-color: transparent;
                                          -fx-border-color: transparent;
                                          -fx-padding: 0 4 0 4; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtPasswordVisible" HBox.hgrow="ALWAYS"
                               visible="false" managed="false"
                               promptText="Masukkan password..."
                               style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-padding: 0 4 0 4; -fx-font-size: 13px;"/>
                    <Button fx:id="btnTogglePassword" text="👁"
                            onAction="#onTogglePassword"
                            style="-fx-background-color: transparent;
                                   -fx-border-color: transparent;
                                   -fx-text-fill: #94a3b8; -fx-font-size: 14px;
                                   -fx-padding: 0 14 0 6; -fx-cursor: hand;"/>
                </HBox>

                <Region prefHeight="8"/>

                <!-- Label error -->
                <Label fx:id="lblError" text=""
                       visible="false" managed="false"
                       style="-fx-text-fill: #dc2626; -fx-font-size: 12px;"/>

                <Region prefHeight="24"/>

                <!-- Tombol Masuk -->
                <Button fx:id="btnMasuk" text="Masuk" onAction="#onMasuk"
                        maxWidth="10000" prefHeight="48"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white;
                               -fx-background-radius: 10; -fx-font-size: 14px;
                               -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>
    </VBox>

    <!-- Tombol kembali: anchor pojok kiri atas, tidak mengikuti centering -->
    <Button text="← Kembali ke Kiosk" onAction="#handleKembali"
            AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20"
            style="-fx-background-color: transparent;
                   -fx-border-color: transparent;
                   -fx-text-fill: #2563eb; -fx-font-size: 12px;
                   -fx-padding: 6 12 6 12; -fx-cursor: hand;"/>

</AnchorPane>
