<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.grincare.controller.LoginAdminController"
           style="-fx-background-color: #f1f5f9;"
           prefWidth="1280" prefHeight="800">

    <!-- Card login di tengah layar -->
    <VBox spacing="20" maxWidth="420"
          style="-fx-background-color: white;
                 -fx-background-radius: 16;
                 -fx-padding: 36 36 32 36;
                 -fx-effect: dropshadow(three-pass-box, #cbd5e1, 12, 0, 0, 3);">

        <!-- Header -->
        <VBox spacing="6" style="-fx-alignment: CENTER;">
            <Label text="🔐" style="-fx-font-size: 36px;"/>
            <Label text="Login Admin"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Label text="Akses panel manajemen klinik"
                   style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <!-- Separator -->
        <Region maxWidth="10000"
                style="-fx-background-color: #e2e8f0; -fx-pref-height: 1; -fx-max-height: 1;"/>

        <!-- Field Username -->
        <VBox spacing="6">
            <Label text="Username"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: #f8fafc;
                         -fx-background-radius: 8;
                         -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;">
                <Label text="👤"
                       style="-fx-font-size: 16px; -fx-padding: 10 8 10 14; -fx-text-fill: #94a3b8;"/>
                <TextField fx:id="txtUsername" HBox.hgrow="ALWAYS"
                           promptText="Masukkan username..."
                           style="-fx-background-color: transparent; -fx-border-color: transparent;
                                  -fx-padding: 10 14 10 4; -fx-font-size: 13px;"/>
            </HBox>
        </VBox>

        <!-- Field Password -->
        <VBox spacing="6">
            <Label text="Password"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: #f8fafc;
                         -fx-background-radius: 8;
                         -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;">
                <Label text="🔒"
                       style="-fx-font-size: 16px; -fx-padding: 10 8 10 14; -fx-text-fill: #94a3b8;"/>
                <!-- PasswordField (default, tersembunyi saat toggle ON) -->
                <PasswordField fx:id="txtPassword" HBox.hgrow="ALWAYS"
                               promptText="Masukkan password..."
                               style="-fx-background-color: transparent; -fx-border-color: transparent;
                                      -fx-padding: 10 4 10 4; -fx-font-size: 13px;"/>
                <!-- TextField tampil saat toggle show password, awalnya hidden -->
                <TextField fx:id="txtPasswordVisible" HBox.hgrow="ALWAYS"
                           visible="false" managed="false"
                           promptText="Masukkan password..."
                           style="-fx-background-color: transparent; -fx-border-color: transparent;
                                  -fx-padding: 10 4 10 4; -fx-font-size: 13px;"/>
                <Button fx:id="btnTogglePassword" text="👁" onAction="#onTogglePassword"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: #94a3b8; -fx-font-size: 14px;
                               -fx-padding: 0 14 0 6; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <!-- Label error (hidden saat awal) -->
        <Label fx:id="lblError" text=""
               visible="false" managed="false"
               style="-fx-text-fill: #dc2626; -fx-font-size: 12px;"/>

        <!-- Tombol Masuk -->
        <Button fx:id="btnMasuk" text="Masuk" onAction="#onMasuk"
                maxWidth="10000"
                style="-fx-background-color: #2563eb; -fx-text-fill: white;
                       -fx-background-radius: 10; -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-padding: 13 0 13 0; -fx-cursor: hand;"/>
    </VBox>

    <!-- Tombol kembali di pojok kiri atas -->
    <!-- pickOnBounds="false": hanya area tombol yang menangkap klik, bukan seluruh HBox 1280x800 -->
    <HBox StackPane.alignment="TOP_LEFT" pickOnBounds="false" style="-fx-padding: 16;">
        <Button text="← Kembali ke Kiosk" onAction="#handleKembali"
                style="-fx-background-color: transparent; -fx-border-color: transparent;
                       -fx-text-fill: #64748b; -fx-font-size: 12px;
                       -fx-padding: 6 12 6 12; -fx-cursor: hand;"/>
    </HBox>

</StackPane>
