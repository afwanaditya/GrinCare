<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>

<VBox style="-fx-background-color: #fafafe; -fx-alignment: CENTER;" 
      stylesheets="@../css/style.css"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.grincare.controller.KonfirmasiAntrianController">
    <!-- Wrapper konten agar tetap di tengah dengan max-width -->
    <VBox spacing="24" style="-fx-max-width: 600; -fx-padding: 40;">

        <!-- Header -->
        <VBox spacing="6">
            <Label text="Anda telah masuk antrian" style="-fx-font-size: 32px; -fx-font-weight: 800; -fx-text-fill: #1a2533;"/>
            <Label text="Kami akan memanggil Anda sesuai nomor urut." style="-fx-font-size: 15px; -fx-text-fill: #5f6b7a;"/>
        </VBox>

        <!-- Blue Card Container -->
        <VBox spacing="24" style="-fx-background-color: #0077cc; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 32; -fx-effect: dropshadow(gaussian, rgba(0, 119, 204, 0.3), 10, 0.5, 0, 4);">
            
            <VBox spacing="4" style="-fx-alignment: CENTER;">
                <Label text="NOMOR ANTRIAN ANDA" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: rgba(255, 255, 255, 0.8); -fx-letter-spacing: 0.1em;"/>
                <Label fx:id="labelNoAntrian" text="—" style="-fx-font-size: 64px; -fx-font-weight: 800; -fx-text-fill: white; -fx-padding: -10 0 0 0;"/>
            </VBox>

            <!-- Bottom Bento Grid inside card -->
            <HBox spacing="16">
                <!-- Bento Col 1: Layanan -->
                <VBox spacing="8" style="-fx-background-color: rgba(255, 255, 255, 0.15); -fx-background-radius: 12; -fx-padding: 16; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS">
                    <Label text="Layanan" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: rgba(255, 255, 255, 0.85);"/>
                    <Label fx:id="labelLayanan" text="—" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: white; -fx-text-alignment: CENTER;" wrapText="true" textAlignment="CENTER"/>
                </VBox>

                <!-- Bento Col 2: Stacked -->
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <HBox spacing="12" style="-fx-background-color: rgba(255, 255, 255, 0.15); -fx-background-radius: 12; -fx-padding: 12; -fx-alignment: CENTER_LEFT;">
                        <VBox spacing="2">
                            <Label text="Ticket ID" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: rgba(255, 255, 255, 0.85);"/>
                            <Label fx:id="labelTicketId" text="—" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="12" style="-fx-background-color: rgba(255, 255, 255, 0.15); -fx-background-radius: 12; -fx-padding: 12; -fx-alignment: CENTER_LEFT;">
                        <VBox spacing="2">
                            <Label text="Estimasi Waktu" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: rgba(255, 255, 255, 0.85);"/>
                            <Label fx:id="labelEstimasiWaktu" text="—" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Bento Col 3: Stacked -->
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <HBox spacing="12" style="-fx-background-color: rgba(255, 255, 255, 0.15); -fx-background-radius: 12; -fx-padding: 12; -fx-alignment: CENTER_LEFT;">
                        <VBox spacing="2">
                            <Label text="WhatsApp" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: rgba(255, 255, 255, 0.85);"/>
                            <Label fx:id="labelWa" text="—" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="12" style="-fx-background-color: rgba(255, 255, 255, 0.15); -fx-background-radius: 12; -fx-padding: 12; -fx-alignment: CENTER_LEFT;">
                        <VBox spacing="2">
                            <Label text="Di Depan Anda" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: rgba(255, 255, 255, 0.85);"/>
                            <Label fx:id="labelOrangDiDepan" text="—" style="-fx-font-size: 14px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>

        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Progress Bar & Timer -->
        <VBox spacing="8">
            <ProgressBar fx:id="progressBar" progress="1.0" maxWidth="10000" prefHeight="6" style="-fx-accent: #0077cc; -fx-control-inner-background: #e2e8f0;"/>
            <Label fx:id="labelCountdown" text="Menutup otomatis dalam 30 detik..." style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
        </VBox>

        <HBox spacing="16">
            <Button text="KEMBALI KE AWAL SEKARANG" onAction="#handleSelesai" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #1a2533; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 14 0; -fx-cursor: hand;" HBox.hgrow="ALWAYS" maxWidth="10000" />
        </HBox>

    </VBox>
</VBox>
