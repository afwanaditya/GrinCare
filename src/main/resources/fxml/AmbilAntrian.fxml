<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>

<VBox style="-fx-background-color: #fafafe; -fx-alignment: CENTER;" 
      stylesheets="@../css/style.css"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.grincare.controller.AmbilAntrianController">

    <!-- Wrapper konten agar tetap di tengah dengan max-width -->
    <VBox spacing="24" style="-fx-max-width: 600; -fx-padding: 40;">

        <!-- Header -->
        <VBox spacing="6">
            <HBox spacing="6" style="-fx-alignment: CENTER_LEFT;">
                <Label text="Data Pasien" style="-fx-font-size: 32px; -fx-font-weight: 800; -fx-text-fill: #1a2533;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Kategori badge disisipkan di sini agar fungsi controller tidak rusak -->
                <Label fx:id="labelKategori" text="Pemeriksaan Umum"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 4 10 4 10;
                              -fx-background-color: #e8f9f2; -fx-text-fill: #006c4a;
                              -fx-border-color: #19c389; -fx-border-radius: 12; -fx-background-radius: 12;"/>
            </HBox>
        </VBox>

        <!-- Card Container -->
        <VBox spacing="24" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 32;">
            
            <!-- Full name -->
            <VBox spacing="8">
                <Label text="Nama Lengkap" style="-fx-font-weight: bold; -fx-text-fill: #1a2533; -fx-font-size: 14px;"/>
                <HBox spacing="12" style="-fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12 16; -fx-alignment: CENTER_LEFT;">
                    <SVGPath content="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" fill="transparent" stroke="#64748b" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                    <TextField fx:id="namaField" promptText="Masukkan nama lengkap" style="-fx-background-color: transparent; -fx-padding: 0; -fx-font-size: 15px; -fx-text-fill: #1a2533;" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Contact number -->
            <VBox spacing="8">
                <Label text="Nomor WhatsApp (opsional)" style="-fx-font-weight: bold; -fx-text-fill: #1a2533; -fx-font-size: 14px;"/>
                <HBox spacing="12" style="-fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12 16; -fx-alignment: CENTER_LEFT;">
                    <SVGPath content="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" fill="transparent" stroke="#64748b" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                    <TextField fx:id="waField" promptText="08123456789" style="-fx-background-color: transparent; -fx-padding: 0; -fx-font-size: 15px; -fx-text-fill: #1a2533;" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Privacy Notice -->
            <HBox spacing="12" style="-fx-background-color: #f0f3ff; -fx-background-radius: 8; -fx-padding: 16;">
                <VBox style="-fx-alignment: TOP_CENTER; -fx-padding: 2 0 0 0;">
                    <SVGPath content="M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2z M7 11V7a5 5 0 0 1 10 0v4" fill="transparent" stroke="#0077cc" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                </VBox>
                <Label text="Privasi Anda adalah prioritas kami. Informasi ini disimpan dengan aman dan digunakan secara eksklusif untuk perawatan Anda selama kunjungan ini." wrapText="true" style="-fx-font-size: 13.5px; -fx-text-fill: #404752; -fx-line-spacing: 0.2em;"/>
            </HBox>

            <Label fx:id="labelError" text="" style="-fx-text-fill: #f44444; -fx-font-size: 13px;"/>

        </VBox>

        <!-- Buttons -->
        <HBox spacing="16" style="-fx-padding: 0 0 0 0;">
            <Button text="Kembali" onAction="#handleKembali" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #1a2533; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 14 36; -fx-cursor: hand;" />
            <Button fx:id="btnAmbil" text="KONFIRMASI &amp; AMBIL ANTRIAN" onAction="#handleAmbilAntrian" style="-fx-background-color: #0077cc; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 8; -fx-padding: 14 0; -fx-cursor: hand;" HBox.hgrow="ALWAYS" maxWidth="10000"/>
        </HBox>

    </VBox>
</VBox>
