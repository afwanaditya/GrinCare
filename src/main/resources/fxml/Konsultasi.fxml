<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox style="-fx-background-color: #fafafe;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.grincare.controller.KonsultasiController">

    <!-- ===== HEADER ===== -->
    <HBox spacing="16" style="-fx-background-color: white; -fx-padding: 16 24 16 24; -fx-alignment: CENTER_LEFT; -fx-border-color: transparent transparent #c0c7d3 transparent; -fx-border-width: 1;">
        <VBox spacing="2" style="-fx-alignment: CENTER_LEFT;">
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #222936;" text="GrinCare" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: #404752;" text="Solusi Kesehatan Gigi Anda" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <VBox spacing="2" style="-fx-alignment: CENTER_RIGHT;">
            <Label fx:id="labelTanggal" style="-fx-font-size: 12px; -fx-text-fill: #404752;" text="" />
            <Label fx:id="labelJam" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0077cc;" text="" />
        </VBox>
        <Button onAction="#handleLoginAdmin"
                style="-fx-background-color: white; -fx-border-color: #c0c7d3; -fx-border-radius: 20; -fx-border-width: 1; -fx-background-radius: 20; -fx-text-fill: #404752; -fx-font-size: 12px; -fx-padding: 6 18 6 18; -fx-cursor: hand;" text="  Login Admin" />
    </HBox>

    <!-- ===== KONTEN UTAMA (2 kolom) ===== -->
    <HBox spacing="24" style="-fx-padding: 24 24 24 24; -fx-alignment: TOP_LEFT;" VBox.vgrow="ALWAYS">

        <!-- ========== KOLOM KIRI: CHAT CARD ========== -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #c0c7d3; -fx-border-radius: 16; -fx-border-width: 1;" HBox.hgrow="ALWAYS">

            <!-- Card Header -->
            <VBox style="-fx-padding: 16 24 16 24; -fx-border-color: transparent transparent #c0c7d3 transparent; -fx-border-width: 1;">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #222936;" text="Jelaskan keluhan Anda" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #404752;" text="Chat senatural mungkin — Ginny AI kami akan mencari layanan yang tepat." />
            </VBox>

            <!-- Area pesan chat -->
            <VBox spacing="16" style="-fx-padding: 24 24 16 24;" VBox.vgrow="ALWAYS">
                <!-- Bubble sambutan bot -->
                <HBox spacing="12" style="-fx-alignment: TOP_LEFT;">
                    <StackPane style="-fx-background-color: #e8eeff; -fx-background-radius: 21; -fx-min-width: 42; -fx-min-height: 42; -fx-pref-width: 42; -fx-pref-height: 42; -fx-max-width: 42; -fx-max-height: 42; -fx-alignment: CENTER;">
                        <SVGPath content="M12 8 V4 H8 M6 8 h12 a2 2 0 0 1 2 2 v8 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 v-8 a2 2 0 0 1 2 -2 z M2 14 h2 M20 14 h2 M15 13 v2 M9 13 v2" fill="transparent" stroke="#005ea3" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label maxWidth="450" style="-fx-background-color: #f0f3ff; -fx-background-radius: 0 16 16 16; -fx-padding: 12 16 12 16; -fx-font-size: 14px; -fx-text-fill: #222936; -fx-line-spacing: 0.2em;" text="Selamat datang! Saya Ginny, siap membantu Anda mendapatkan perawatan gigi yang tepat. Apa keluhan yang Anda rasakan hari ini?" wrapText="true" />
                        <Label fx:id="labelTimestamp" style="-fx-font-size: 11px; -fx-text-fill: #5f6673;" text="" />
                    </VBox>
                </HBox>

                <!-- Hasil konsultasi Ginny -->
                <VBox fx:id="panelHasil" managed="false" spacing="10" visible="false">
                    <HBox spacing="12" style="-fx-alignment: TOP_LEFT;">
                        <StackPane style="-fx-background-color: #e8eeff; -fx-background-radius: 21; -fx-min-width: 42; -fx-min-height: 42; -fx-pref-width: 42; -fx-pref-height: 42; -fx-max-width: 42; -fx-max-height: 42; -fx-alignment: CENTER;">
                            <SVGPath content="M12 8 V4 H8 M6 8 h12 a2 2 0 0 1 2 2 v8 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 v-8 a2 2 0 0 1 2 -2 z M2 14 h2 M20 14 h2 M15 13 v2 M9 13 v2" fill="transparent" stroke="#005ea3" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                        </StackPane>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <TextArea fx:id="areaEdukasi" editable="false" maxWidth="10000" prefHeight="100" style="-fx-control-inner-background: #f0f3ff; -fx-background-color: #f0f3ff, #f0f3ff; -fx-background-radius: 0 16 16 16; -fx-background-insets: 0; -fx-border-color: transparent; -fx-border-width: 0; -fx-padding: 12 16 12 16; -fx-font-size: 14px; -fx-text-fill: #222936;" wrapText="true" />
                            <Label fx:id="labelKategoriHasil" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #006c4a; -fx-padding: 8 16 8 16; -fx-background-color: #e8f9f2; -fx-border-color: #19c389; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Loading indicator -->
                <Label fx:id="labelLoading" managed="false" style="-fx-text-fill: #404752; -fx-font-style: italic; -fx-font-size: 13px;" text="⏳  Ginny sedang menganalisis..." visible="false" />
                <Label fx:id="labelError" style="-fx-text-fill: #f44444; -fx-font-size: 13px;" text="" />
            </VBox>

            <!-- Card Footer (Input & Quick Chips) -->
            <VBox style="-fx-padding: 16 24 16 24; -fx-border-color: #c0c7d3 transparent transparent transparent; -fx-border-width: 1;" spacing="12">
                <!-- Quick Chips (UI Only) -->
                <HBox spacing="8" style="-fx-alignment: CENTER_LEFT;">
                    <Button style="-fx-background-color: #f0f3ff; -fx-border-color: #c0c7d3; -fx-border-radius: 20; -fx-border-width: 1; -fx-background-radius: 20; -fx-text-fill: #005ea3; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 6 16 6 16; -fx-cursor: hand;" text="Sakit Gigi" />
                    <Button style="-fx-background-color: #f0f3ff; -fx-border-color: #c0c7d3; -fx-border-radius: 20; -fx-border-width: 1; -fx-background-radius: 20; -fx-text-fill: #005ea3; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 6 16 6 16; -fx-cursor: hand;" text="Karang Gigi" />
                    <Button style="-fx-background-color: #f0f3ff; -fx-border-color: #c0c7d3; -fx-border-radius: 20; -fx-border-width: 1; -fx-background-radius: 20; -fx-text-fill: #005ea3; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 6 16 6 16; -fx-cursor: hand;" text="Gigi Berlubang" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button style="-fx-background-color: transparent; -fx-text-fill: #0077cc; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" text="Kategori Cepat" />
                </HBox>

                <HBox spacing="12" style="-fx-alignment: CENTER_LEFT;">
                    <TextField fx:id="keluhanField" promptText="Contoh: Gigi bawah kiri saya ngilu saat minum dingin..." style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #c0c7d3; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 14 18 14 18; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnKirim" onAction="#handleKirim" style="-fx-background-color: #0077cc; -fx-background-radius: 12; -fx-padding: 12 20 12 20; -fx-cursor: hand; -fx-min-width: 60;">
                        <graphic>
                            <SVGPath content="M22 2 L15 22 L11 13 L2 9 Z M22 2 L11 13" fill="transparent" stroke="white" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>

        <!-- ========== KOLOM KANAN: SIDEBAR ========== -->
        <VBox spacing="16" style="-fx-min-width: 320; -fx-pref-width: 340; -fx-max-width: 340;">
            
            <!-- Real-time analysis card / Triage Privacy -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #c0c7d3; -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20;">
                <HBox spacing="8" style="-fx-alignment: CENTER_LEFT;">
                    <SVGPath content="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2-1 4-2 7-2 2.5 0 4.5 1 7 2a1 1 0 0 1 1 1z M9 12 l2 2 l4 -4" fill="transparent" stroke="#19c389" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #404752; -fx-wrap-text: true;" text="Jawaban Anda hanya digunakan untuk penentuan layanan dan tidak akan dibagikan." />
                </HBox>
            </VBox>

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #222936;" text="Informasi Antrian" />

            <!-- Nomor antrian berikutnya -->
            <VBox spacing="6" style="-fx-background-color: #f0f3ff; -fx-background-radius: 12; -fx-border-color: #d2e4ff; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 16 18 16 18;">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #404752;" text="Nomor Antrian Saat Ini" />
                <Label fx:id="labelNomorAntrian" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #0077cc;" text="..." />
            </VBox>

            <!-- Estimasi waktu tunggu -->
            <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #c0c7d3; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 16 18 16 18;">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #404752;" text="🕐   Estimasi Waktu Tunggu" />
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #222936;" text="15-20 menit" />
            </VBox>

            <!-- Jumlah antrian aktif -->
            <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #c0c7d3; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 16 18 16 18;">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #404752;" text="👥   Jumlah Antrian Saat Ini" />
                <Label fx:id="labelJumlahAntrian" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #222936;" text="..." />
            </VBox>

            <!-- Review & Continue Buttons -->
            <VBox spacing="12" style="-fx-padding: 8 0 0 0;">
                <Button fx:id="btnLanjut" disable="true" maxWidth="10000" onAction="#handleLanjut" style="-fx-background-color: #0077cc; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 16 0 16 0; -fx-cursor: hand;" text="Ambil Nomor Antrian" HBox.hgrow="ALWAYS" />
                <Button maxWidth="10000" onAction="#handleLewati" style="-fx-background-color: white; -fx-border-color: #0077cc; -fx-border-radius: 12; -fx-border-width: 2; -fx-background-radius: 12; -fx-text-fill: #0077cc; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 14 0 14 0; -fx-cursor: hand;" text="Lewati &amp; Ambil Antrian Manual" HBox.hgrow="ALWAYS" />
            </VBox>

        </VBox>
    </HBox>

    <!-- Toast notification -->
    <HBox fx:id="toastBox" managed="false" style="-fx-background-color: #19c389; -fx-padding: 14 24 14 24; -fx-alignment: CENTER;" visible="false">
        <Label fx:id="labelToast" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="" />
    </HBox>
</VBox>
