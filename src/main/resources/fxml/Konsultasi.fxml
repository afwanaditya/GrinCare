<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox style="-fx-background-color: #f1f5f9;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.grincare.controller.KonsultasiController">

    <!-- ===== HEADER ===== -->
    <HBox spacing="16" style="-fx-background-color: white;                  -fx-padding: 16 24 16 24;                  -fx-alignment: CENTER_LEFT;">

        <!-- Teks GrinCare + subjudul (tanpa logo box) -->
        <VBox spacing="2" style="-fx-alignment: CENTER_LEFT;">
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="GrinCare" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" text="Solusi Kesehatan Gigi Anda" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Tanggal + jam -->
        <VBox spacing="2" style="-fx-alignment: CENTER_RIGHT;">
            <Label fx:id="labelTanggal" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" text="" />
            <Label fx:id="labelJam" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="" />
        </VBox>

        <!-- Login Admin (border abu tipis) -->
        <Button onAction="#handleLoginAdmin"
                style="-fx-background-color: white;                        -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-border-width: 1;                        -fx-background-radius: 20;                        -fx-text-fill: #64748b; -fx-font-size: 12px;                        -fx-padding: 6 18 6 18; -fx-cursor: hand;" text="  Login Admin" />
    </HBox>

    <!-- Garis gradient biru di bawah header -->
    <Region style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #1d4ed8, #38bdf8);                    -fx-min-height: 3; -fx-pref-height: 3; -fx-max-height: 3;" />

    <!-- Link kembali (kecil, subtle) -->
    <HBox style="-fx-padding: 8 24 0 24;">
        <Button onAction="#handleKembali" style="-fx-background-color: transparent; -fx-border-color: transparent;                        -fx-text-fill: #94a3b8; -fx-font-size: 11px;                        -fx-padding: 0; -fx-cursor: hand;" text="← Kembali ke Kategori" />
    </HBox>

    <!-- ===== KONTEN UTAMA (2 kolom) ===== -->
    <HBox spacing="16" style="-fx-padding: 10 24 20 24; -fx-alignment: TOP_LEFT;" VBox.vgrow="ALWAYS">

        <!-- ========== KOLOM KIRI: CHAT CARD ========== -->
        <VBox style="-fx-background-color: white;                      -fx-background-radius: 16;                      -fx-effect: dropshadow(three-pass-box, #cbd5e1, 10, 0, 0, 2);" HBox.hgrow="ALWAYS">

            <!-- Area pesan chat (tumbuh mengisi sisa tinggi) -->
            <VBox spacing="14" style="-fx-padding: 20 20 14 20;" VBox.vgrow="ALWAYS">

                <!-- Bubble sambutan bot -->
                <HBox spacing="12" style="-fx-alignment: TOP_LEFT;">
                    <StackPane style="-fx-background-color: #dbeafe;                                       -fx-background-radius: 21;                                       -fx-min-width: 42; -fx-min-height: 42;                                       -fx-pref-width: 42; -fx-pref-height: 42;                                       -fx-alignment: CENTER;">
                        <Label style="-fx-font-size: 20px;" text="🤖" />
                    </StackPane>
                    <VBox spacing="4">
                        <Label maxWidth="400" style="-fx-background-color: #f1f5f9;                                       -fx-background-radius: 0 12 12 12;                                       -fx-padding: 12 16 12 16;                                       -fx-font-size: 13px; -fx-text-fill: #334155;" text="Selamat datang di Klinik Gigi Sehat. Saya adalah asisten virtual Anda. Silakan pilih keluhan Anda atau ketik pertanyaan." wrapText="true" />
                        <Label fx:id="labelTimestamp" style="-fx-font-size: 11px; -fx-text-fill: #cbd5e1;" text="" />
                    </VBox>
                </HBox>

                <!-- Hasil konsultasi Ginny (tersembunyi sampai ada response) -->
                <VBox fx:id="panelHasil" managed="false" spacing="10" visible="false">
                    <HBox spacing="12" style="-fx-alignment: TOP_LEFT;">
                        <StackPane style="-fx-background-color: #dbeafe;                                           -fx-background-radius: 21;                                           -fx-min-width: 42; -fx-min-height: 42;                                           -fx-pref-width: 42; -fx-pref-height: 42;                                           -fx-alignment: CENTER;">
                            <Label style="-fx-font-size: 20px;" text="🤖" />
                        </StackPane>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <TextArea fx:id="areaEdukasi" editable="false" maxWidth="10000" prefHeight="100" style="-fx-control-inner-background: #f1f5f9;                                              -fx-background-color: #f1f5f9, #f1f5f9;                                              -fx-background-radius: 0 12 12 12;                                              -fx-background-insets: 0;                                              -fx-border-color: transparent; -fx-border-width: 0;                                              -fx-padding: 12 16 12 16;                                              -fx-font-size: 13px; -fx-text-fill: #334155;" wrapText="true" />
                            <Label fx:id="labelKategoriHasil" style="-fx-font-size: 13px; -fx-font-weight: bold;                                           -fx-text-fill: #15803d; -fx-padding: 6 12 6 12;                                           -fx-background-color: #dcfce7;                                           -fx-border-color: #86efac; -fx-border-width: 1;                                           -fx-border-radius: 6; -fx-background-radius: 6;" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Loading indicator -->
                <Label fx:id="labelLoading" managed="false" style="-fx-text-fill: #94a3b8; -fx-font-style: italic; -fx-font-size: 12px;" text="⏳  Ginny sedang menganalisis keluhan Anda..." visible="false" />

                <!-- Error validasi -->
                <Label fx:id="labelError" style="-fx-text-fill: #dc2626; -fx-font-size: 12px;" text="" />
            </VBox>

            <!-- Pemisah tipis -->
            <Region style="-fx-background-color: #e2e8f0;                            -fx-min-height: 1; -fx-pref-height: 1; -fx-max-height: 1;" />

            <!-- Hint + Kategori Cepat -->
            <HBox spacing="8" style="-fx-padding: 10 20 10 20; -fx-alignment: CENTER_LEFT;">
                <Label style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;" text="Tidak tahu harus ketik apa?" />
                <Region HBox.hgrow="ALWAYS" />
                <Button style="-fx-background-color: #eff6ff;                                -fx-border-color: #93c5fd; -fx-border-radius: 16; -fx-border-width: 1;                                -fx-background-radius: 16;                                -fx-text-fill: #2563eb; -fx-font-size: 11px;                                -fx-padding: 5 14 5 14; -fx-cursor: hand;" text="📋  Kategori Cepat" />
            </HBox>

            <!-- Input keluhan + Kirim -->
            <HBox spacing="10" style="-fx-padding: 0 20 14 20; -fx-alignment: CENTER_LEFT;">
                <TextField fx:id="keluhanField" promptText="Ketik keluhan Anda di sini..." style="-fx-background-color: #f8fafc;                                   -fx-background-radius: 24;                                   -fx-border-color: #e2e8f0; -fx-border-radius: 24; -fx-border-width: 1;                                   -fx-padding: 10 18 10 18; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnKirim" onAction="#handleKirim" style="-fx-background-color: #2563eb; -fx-text-fill: white;                                -fx-background-radius: 24; -fx-font-size: 13px; -fx-font-weight: bold;                                -fx-padding: 10 22 10 22; -fx-cursor: hand;" text="✈  Kirim" />
            </HBox>

            <!-- Tombol aksi bawah card -->
            <HBox spacing="12" style="-fx-padding: 0 20 20 20;">
                <!-- Ambil Antrian: abu/disabled sampai AI beri rekomendasi valid -->
                <Button fx:id="btnLanjut" disable="true" maxWidth="10000" onAction="#handleLanjut" style="-fx-background-color: #e2e8f0; -fx-text-fill: #94a3b8;                                -fx-background-radius: 8; -fx-font-size: 13px;                                -fx-padding: 12 0 12 0;" text="Ambil Nomor Antrian" HBox.hgrow="ALWAYS" />
                <!-- Lewati: selalu aktif -->
                <Button maxWidth="10000" onAction="#handleLewati" style="-fx-background-color: white;                                -fx-border-color: #2563eb; -fx-border-radius: 8; -fx-border-width: 1;                                -fx-background-radius: 8;                                -fx-text-fill: #2563eb; -fx-font-size: 13px;                                -fx-padding: 12 0 12 0; -fx-cursor: hand;" text="Lewati &amp; Ambil Antrian Manual" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>

        <!-- ========== KOLOM KANAN: INFO ANTRIAN ========== -->
        <VBox spacing="12" style="-fx-min-width: 290; -fx-pref-width: 310; -fx-max-width: 340;">

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Informasi Antrian" />

            <!-- Nomor antrian berikutnya (hijau muda) -->
            <VBox spacing="6" style="-fx-background-color: #f0fdf4; -fx-background-radius: 12;                          -fx-padding: 16 18 16 18;                          -fx-effect: dropshadow(three-pass-box, #d1fae5, 6, 0, 0, 1);">
                <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Nomor Antrian Saat Ini" />
                <Label fx:id="labelNomorAntrian" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="..." />
            </VBox>

            <!-- Estimasi waktu tunggu -->
            <VBox spacing="6" style="-fx-background-color: #f8fafc; -fx-background-radius: 12;                          -fx-padding: 16 18 16 18;                          -fx-effect: dropshadow(three-pass-box, #e2e8f0, 6, 0, 0, 1);">
                <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="🕐   Estimasi Waktu Tunggu" />
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="15-20 menit" />
            </VBox>

            <!-- Jumlah antrian aktif -->
            <VBox spacing="6" style="-fx-background-color: #f8fafc; -fx-background-radius: 12;                          -fx-padding: 16 18 16 18;                          -fx-effect: dropshadow(three-pass-box, #e2e8f0, 6, 0, 0, 1);">
                <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="👥   Jumlah Antrian Saat Ini" />
                <Label fx:id="labelJumlahAntrian" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="..." />
            </VBox>

            <!-- Reminder info (biru muda dengan border biru) -->
            <VBox style="-fx-background-color: #eff6ff;                          -fx-border-color: #93c5fd; -fx-border-width: 1; -fx-border-radius: 12;                          -fx-background-radius: 12; -fx-padding: 14 16 14 16;">
                <HBox spacing="10" style="-fx-alignment: TOP_LEFT;">
                    <Label style="-fx-font-size: 16px; -fx-text-fill: #2563eb;" text="ℹ" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #1d4ed8;" text="Harap tunggu nomor Anda dipanggil. Terima kasih atas kesabaran Anda." wrapText="true" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>

    <!-- Toast notification (muncul sebentar setelah antrian berhasil dibuat) -->
    <HBox fx:id="toastBox" managed="false" style="-fx-background-color: #15803d; -fx-padding: 14 24 14 24; -fx-alignment: CENTER;" visible="false">
        <Label fx:id="labelToast" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="" />
    </HBox>
</VBox>
