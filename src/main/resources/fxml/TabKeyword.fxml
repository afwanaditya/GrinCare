<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox spacing="16" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.grincare.controller.TabKeywordController">

    <stylesheets>
        <String fx:value="/css/TabKategori.css"/>
    </stylesheets>

    <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

    <!-- Toolbar -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Kelola Keyword AI (Fallback)" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="+ Tambahkan Kata Kunci" onAction="#handleTambah"
                style="-fx-background-color: #0284c7; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-background-radius: 6; -fx-border-radius: 6;
                       -fx-padding: 8 20 8 20; -fx-cursor: hand;"/>
    </HBox>

    <!-- Card putih berisi tabel -->
    <VBox VBox.vgrow="ALWAYS"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

        <TableView fx:id="tabelEdge" VBox.vgrow="ALWAYS" fixedCellSize="52">
            <columns>
                <TableColumn fx:id="colSource" text="KATA KUNCI ASAL"     prefWidth="250" minWidth="150"/>
                <TableColumn fx:id="colTarget" text="TUJUAN (KATEGORI)" prefWidth="350" minWidth="200"/>
                <TableColumn fx:id="colWeight" text="BOBOT HUBUNGAN"    prefWidth="150" minWidth="100"/>
                <TableColumn fx:id="colAksi"   text="AKSI"              prefWidth="160" minWidth="160" maxWidth="160"/>
            </columns>
            <placeholder>
                <Label text="Belum ada data hubungan kata kunci." textFill="#6b7280" />
            </placeholder>
        </TableView>

    </VBox>
</VBox>
