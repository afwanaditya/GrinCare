<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox spacing="16" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.grincare.controller.TabAntrianController">

    <stylesheets>
        <String fx:value="/css/TabAntrian.css"/>
    </stylesheets>

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- Header: judul + badge jumlah aktif -->
    <HBox spacing="12" style="-fx-alignment: CENTER_LEFT;">
        <VBox spacing="3">
            <Label text="Manajemen Antrian"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Label text="Kelola antrian pasien klinik hari ini"
                   style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="6" style="-fx-alignment: CENTER;
                                  -fx-background-color: #dbeafe;
                                  -fx-background-radius: 20;
                                  -fx-padding: 6 16 6 16;">
            <Label text="Antrian Aktif:"
                   style="-fx-font-size: 12px; -fx-text-fill: #2563eb;"/>
            <Label fx:id="labelJumlahAktif" text="0"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
        </HBox>
    </HBox>

    <!-- Card putih berisi tabel -->
    <VBox VBox.vgrow="ALWAYS"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

        <TableView fx:id="tabelAntrian" VBox.vgrow="ALWAYS" fixedCellSize="52">
            <columns>
                <TableColumn fx:id="colNoAntrian" text="No. Antrian"
                             prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="colNama"      text="Nama Pasien"
                             prefWidth="150" minWidth="120"/>
                <TableColumn fx:id="colNoWA"      text="No. WhatsApp"
                             prefWidth="150" minWidth="120"/>
                <TableColumn fx:id="colKategori"  text="Kategori Layanan"
                             prefWidth="180" minWidth="140"/>
                <TableColumn fx:id="colStatus"    text="Status"
                             prefWidth="120" minWidth="100"/>
                <TableColumn fx:id="colAksi"      text="Aksi"
                             prefWidth="200" minWidth="200" maxWidth="200"/>
            </columns>
            <placeholder>
                <Label text="Belum ada antrian aktif hari ini."/>
            </placeholder>
        </TableView>

    </VBox>

    <!-- Footer -->
    <HBox spacing="12" style="-fx-alignment: CENTER_LEFT;">
        <Button text="Hapus Data Selesai" onAction="#onHapusDataSelesai"
                styleClass="btn-hapus-selesai"/>
        <Label text="Data antrian direset setiap hari"
               style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
    </HBox>

    <!-- Toast notification -->
    <HBox fx:id="toastBox" managed="false" visible="false"
          style="-fx-background-color: #1e3a5f;
                 -fx-background-radius: 8;
                 -fx-padding: 10 20 10 20;
                 -fx-alignment: CENTER;">
        <Label fx:id="labelToast" text=""
               style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;"/>
    </HBox>

</VBox>
